{
  "name": "badminton-matcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:manifest": "vue-tsc -b && vite build --manifest && tsx docs/research/scripts/rotation-wildcard-simulation/verify-production-isolation.ts && tsx docs/research/scripts/rotation-wildcard-simulation/verify-release-authority.ts",
    "preview": "vite preview",
    "simulation:smoke": "tsx docs/research/scripts/rotation-wildcard-simulation/smoke.ts",
    "simulation:representative": "tsx docs/research/scripts/rotation-wildcard-simulation/representative.ts",
    "test": "vitest run",
    "test:simulation": "vitest run docs/research/scripts/rotation-wildcard-simulation/*.test.ts",
    "verify:production-isolation": "tsx docs/research/scripts/rotation-wildcard-simulation/verify-production-isolation.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "20.11.2",
    "tsx": "4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
